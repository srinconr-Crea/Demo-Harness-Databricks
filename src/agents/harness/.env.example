# Referencia de arranque FastAPI; no se carga .env automáticamente.
# Exportar variables en el proceso o usar el perfil CLI aprobado.
DATABRICKS_CONFIG_PROFILE=<perfil-cli-aprobado>
HARNESS_CLIENT_PROFILE_PATH=config/deployment/client.yaml
HARNESS_CLIENT_PROFILE_SHA256=<sha256-del-perfil-entregado>
PORT=8000

# En Databricks, app.yaml/config del despliegue entrega estas referencias:
# RUN_STORE_DIR=/Volumes/<catalogo-harness>/<schema-harness>/artifacts/runs
# HARNESS_WAREHOUSE_ID=<warehouse-sandbox>
# HARNESS_RUN_STATE_TABLE=<catalogo-harness>.<schema-harness>.demo_harness_run_state
# HARNESS_SANDBOX_JOB_ID=<job-con-identidad-separada>
# HARNESS_SANDBOX_DIR=/Volumes/<catalogo-harness>/<schema-harness>/demo_harness_sandbox
# GITHUB_APP_PRIVATE_KEY se obtiene del secret binding; nunca copiarla aquí.
# Modelos y routing: config/defaults/models.yaml y agents.yaml.
# La HU no selecciona endpoints. Ver docs/configuracion-instalacion.md.
